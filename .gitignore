__pycache__/
*.py[cod]
*$py.class

# Model response cache
.cache/

# Environment
.env
.env.*
.venv/
venv/
ENV/

# Linting/testing caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db

# =============================================================================
# Results artifacts policy
# =============================================================================
# LOCAL (gitignored): generated at runtime, not committed
results/scaling_results.csv
results/per_problem_results.jsonl
results/bootstrap_ci_*.json
results/figures/
results/report_bundle/

# Committed: curated snapshots only
results/snapshots/*
!results/snapshots/.gitkeep
!results/snapshots/*.csv
!results/snapshots/*.json

# Legacy raw/clean CSVs (local only; never commit)
results/scaling_results_raw.csv
results/scaling_results_clean.csv

# =============================================================================
# Writing / paper artifacts (deleted - do not recreate)
# =============================================================================
paper_src/
paper/
brief/
notes/
dist/

# Streamlit cache
dashboard/.streamlit/
